{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONTROLLER",
  "version": "0.22.0",
  "identifier": "studio.aftertouch.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "CONTROLLER  /  DEVICE STUDIO",
        "width": 1510,
        "height": 940,
        "minWidth": 640,
        "minHeight": 560,
        "backgroundColor": "#101e2d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; font-src 'self'; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": ["resources/ViGEmBus_1.22.0_x64_x86_arm64.exe", "resources/ViGEmBus-LICENSE.txt", "resources/DualSense-artwork-LICENSE.txt"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwMzRCQjRDMTI0ODlDQzEKUldUQm5FZ1NUTHMwRUpJekxCMWJ6UFc5NVB5RUs3b1dOOUxuQTRmb3FmSUdOTE9hcmRuVnBwa1UK",
      "endpoints": ["https://github.com/rorohecker/Controller/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
